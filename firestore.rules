rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function activeUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().active == true
        && userProfile().role in ['admin', 'user', 'read'];
    }

    function writer() {
      return activeUser() && userProfile().role in ['admin', 'user'];
    }

    function admin() {
      return activeUser() && userProfile().role == 'admin';
    }

    match /users/{userId} {
      allow read: if activeUser() && (request.auth.uid == userId || admin());
      allow create, update, delete: if admin();
    }

    match /vehicles/{vehicleId} {
      allow read: if activeUser();
      allow create, update: if writer();
      allow delete: if admin();
    }

    match /settings/{settingId} {
      allow read: if activeUser();
      allow create, update, delete: if admin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
